# Mini Drive 서버 배포 환경변수.
#   cp .env.deploy.example .env  후 실제 값으로 채우고  chmod 600 .env
#   (이 .env 는 /opt/flex-drive/deploy/.env 로 두며 절대 커밋하지 않는다.)

# ── 서브패스 ──────────────────────────────────────────
# 기존 nginx 가 https://host/drive → 이 스택으로 프록시하는 경로.
# 반드시 "/" 로 끝낸다. 루트로 붙일 거면 "/".
BASE_PATH=/drive/

# ── Docker Hub 이미지 ─────────────────────────────────
# 이미지 경로: <DOCKERHUB_USER>/flex-drive-backend, .../flex-drive-frontend
DOCKERHUB_USER=your-dockerhub-username
# 배포할 태그. Jenkins 가 배포 시 export IMAGE_TAG=<git-sha> 로 덮어쓴다. 수동 시 latest.
IMAGE_TAG=latest

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME-strong-random
POSTGRES_DB=minidrive

# ── MinIO ─────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE-ME-strong-random
MINIO_BUCKET=minidrive

# ── JWT (반드시 교체: openssl rand -hex 32) ───────────
JWT_SECRET=CHANGE-ME-openssl-rand-hex-32
JWT_ALGORITHM=HS256
