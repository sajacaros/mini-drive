# Mini Drive 서버 배포 환경변수.
#   cp .env.deploy.example .env  후 실제 값으로 채우고  chmod 600 .env
#   (이 .env 는 /var/local/flex-drive/deploy/.env 로 두며 절대 커밋하지 않는다.)

# ── 서브패스 ──────────────────────────────────────────
# 기존 nginx 가 https://host/drive → 이 스택으로 프록시하는 경로.
# 반드시 "/" 로 끝낸다. 루트로 붙일 거면 "/".
BASE_PATH=/drive/

# (이미지는 이 호스트에서 직접 build 한다 — 레지스트리/Docker Hub 계정 불필요.)

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE-ME-strong-random
POSTGRES_DB=minidrive

# ── MinIO ─────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE-ME-strong-random
MINIO_BUCKET=minidrive

# ── JWT (반드시 교체: openssl rand -hex 32) ───────────
JWT_SECRET=CHANGE-ME-openssl-rand-hex-32
JWT_ALGORITHM=HS256

# ── 위키 인덱싱 (spec/wiki-index.md) ──────────────────
# 사내 vLLM 에 붙는다 — 문서 본문이 외부로 나가지 않는다. 주소·모델명은 사내 정보라
# 리포에 기본값을 두지 않았다: 아래 두 줄을 실제 값으로 채워야 wiki-indexer 가 뜬다.
# 채우기 전에 이 호스트에서 도달 가능한지부터 확인:
#   curl -s "$WIKI_LLM_BASE_URL/models"
# 위키 기능을 쓰지 않으려면 WIKI_ENABLED=false 로 두면 된다(사이드카는 유휴 대기).
WIKI_ENABLED=true
WIKI_LLM_BASE_URL=CHANGE-ME-http://<vllm-host>:<port>/v1
WIKI_LLM_MODEL=CHANGE-ME-hosted_vllm/<model-name>
WIKI_LLM_API_KEY=
# 생성 계열은 low 로 충분하다(medium 이상은 추론 토큰이 크게 늘어난다).
WIKI_LLM_REASONING_EFFORT=low
