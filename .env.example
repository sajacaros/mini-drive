# Mini Drive 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 실제 값(특히 시크릿)을 채우세요.
#   cp .env.example .env
# .env 는 절대 버전 관리에 포함하지 마세요 (.gitignore 로 이미 제외됨).

# ── 게이트웨이 (nginx) ────────────────────────────────
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=minidrive

# ── MinIO (오브젝트 스토리지) ─────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_BUCKET=minidrive

# ── JWT ───────────────────────────────────────────────
# 운영에서는 반드시 랜덤한 긴 시크릿으로 교체하세요. 예) openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

# ── 첫 관리자 부트스트랩 (PRD 3.6.2) ──────────────────
# 첫 부팅 시 관리자는 브라우저에서 셋업 위저드(/setup)로 생성합니다.
# 첫 admin 계정 + 초기 가입 코드 + 기본 할당량을 한 번에 설정하고 셋업을 잠급니다.
# ADMIN_* 환경변수 시드는 제거되었습니다. 비상 복구가 필요하면:
#   docker compose exec backend python -m app.cli create-admin --email you@example.com

# ── RAG 인덱싱 (PRD 3.7, Phase 7) ─────────────────────
# arq 워커가 업로드/버전/삭제 훅으로 큐잉된 파일을 텍스트 추출→청킹→임베딩해 file_chunks 에 색인합니다.
# INDEXING_ENABLED=false 로 전체 비활성화(훅이 큐잉을 건너뜀).
INDEXING_ENABLED=true
# 임베딩 프로바이더: upstage(기본, solar-embedding-1-large 4096d) | fake(결정적 해시, 외부 호출 없음).
# fake 는 테스트·키 없는 개발용입니다. upstage 는 아래 UPSTAGE_API_KEY 가 있어야 동작합니다(없으면 스킵).
EMBEDDING_PROVIDER=upstage
# Upstage API 키 (Document Parse + Solar Embedding). 비우면 문서 파싱/upstage 임베딩이 스킵됩니다.
# egress 주의: 인덱싱 시 문서 내용이 Upstage 로 전송됩니다 — 민감 폴더는 인덱싱 제외 플래그로 통제하세요(PRD 3.7.4).
UPSTAGE_API_KEY=

# ── 챗봇 (PRD 3.7, Phase 7-2) ─────────────────────────
# 권한 인지 검색 + LangGraph 파이프라인으로 SSE 스트리밍 답변을 생성합니다.
# CHAT_PROVIDER: vllm(기본, 사내 vLLM GLM 5.2) | openai | upstage(solar-open2, api.upstage.ai/v1)
#                | fake(외부 호출 없는 결정적 답변, 테스트·키 없는 개발용).
# 필수값(키/베이스URL, upstage 는 api_key) 없이 vllm/openai/upstage 면 챗 요청이 503("LLM 미구성")으로 실패합니다.
CHAT_PROVIDER=vllm
# vLLM/OpenAI/Upstage 호환 챗 엔드포인트. egress 주의: 검색 컨텍스트(문서 내용)가 이 서버로 전송됩니다.
# vllm 는 CHAT_BASE_URL + CHAT_API_KEY 필요. openai 는 CHAT_API_KEY 만(BASE_URL 생략 시 OpenAI 기본).
# upstage 는 BASE_URL 생략 시 api.upstage.ai/v1, CHAT_API_KEY 생략 시 위 UPSTAGE_API_KEY 를 폴백으로 씁니다.
CHAT_BASE_URL=
CHAT_API_KEY=
# 미지정 시 프로바이더별 기본 모델(vllm=glm-5.2, openai=gpt-4o-mini, upstage=solar-open2)을 앱이 고릅니다.
CHAT_MODEL=

# ── 로깅 / 메트릭 (PRD 11장) ──────────────────────────
# LOG_FORMAT=console(개발, 컬러) | json(운영). 프로덕션 프로파일은 json 으로 오버라이드됩니다.
LOG_FORMAT=console
LOG_LEVEL=INFO
# /metrics(Prometheus) 노출 여부. 게이트웨이(nginx)에서 외부 접근은 차단됩니다(내부 스크레이프 전용).
METRICS_ENABLED=true
