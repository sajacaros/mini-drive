# Mini Drive 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 실제 값(특히 시크릿)을 채우세요.
#   cp .env.example .env
# .env 는 절대 버전 관리에 포함하지 마세요 (.gitignore 로 이미 제외됨).

# ── 게이트웨이 (nginx) ────────────────────────────────
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# ── PostgreSQL ────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=minidrive

# ── MinIO (오브젝트 스토리지) ─────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-production
MINIO_BUCKET=minidrive

# ── JWT ───────────────────────────────────────────────
# 운영에서는 반드시 랜덤한 긴 시크릿으로 교체하세요. 예) openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256

# ── 첫 관리자 부트스트랩 (PRD 3.6.2) ──────────────────
# 첫 부팅 시 관리자는 브라우저에서 셋업 위저드(/setup)로 생성합니다.
# 첫 admin 계정 + 초기 가입 코드 + 기본 할당량을 한 번에 설정하고 셋업을 잠급니다.
# ADMIN_* 환경변수 시드는 제거되었습니다. 비상 복구가 필요하면:
#   docker compose exec backend python -m app.cli create-admin --email you@example.com

# ── 로깅 / 메트릭 (PRD 11장) ──────────────────────────
# LOG_FORMAT=console(개발, 컬러) | json(운영). 프로덕션 프로파일은 json 으로 오버라이드됩니다.
LOG_FORMAT=console
LOG_LEVEL=INFO
# /metrics(Prometheus) 노출 여부. 게이트웨이(nginx)에서 외부 접근은 차단됩니다(내부 스크레이프 전용).
METRICS_ENABLED=true

# ── 휴지통 보존 기간 (spec/trash-retention-purge.md) ──
# 휴지통 항목을 삭제 후 며칠 뒤에 영구 삭제할지. 기본값이자 권장값은 7 이며,
# **자동 정리를 끄려면 0 을 명시**해야 합니다(값을 비워 두면 기본값 7 이 적용됩니다).
# **이미 운영 중인 스택을 업그레이드할 때는** 예전에 버려진 항목이 첫 회차에 한꺼번에
# 지워지므로, 먼저 규모를 확인하세요 (아무것도 지우지 않습니다):
#   docker compose exec backend python -m app.cli purge-trash --dry-run
TRASH_RETENTION_DAYS=7
# 자동 정리를 실행할 시각 (KST, 0~23). 되돌릴 수 없는 삭제라 사람이 안 쓰는 시간에 돕니다.
TRASH_PURGE_HOUR=4

# ── 위키 인덱싱 (spec/wiki-index.md) ──────────────────
# 문서 본문이 나가는 유일한 곳입니다 — 사내 vLLM(OpenAI 호환) 주소를 넣으세요.
# 끄려면 WIKI_ENABLED=false (사이드카는 유휴 대기합니다).
WIKI_ENABLED=true
# LiteLLM 을 거치므로 모델 이름의 프리픽스가 provider 를 정합니다.
#   자체 호스팅(vLLM 등) → hosted_vllm/<모델명> + BASE_URL
#   SaaS 로 갈아탈 때    → 예) anthropic/claude-sonnet-5, openai/gpt-5 로 바꾸고
#                          **WIKI_LLM_BASE_URL 을 반드시 비우세요** (안 비우면 그 주소로 갑니다).
# 프리픽스 없이 모델명만 있고 BASE_URL 이 있으면 hosted_vllm 으로 봅니다(구버전 설정 호환).
WIKI_LLM_BASE_URL=http://vllm-host:8000/v1
WIKI_LLM_API_KEY=
WIKI_LLM_MODEL=hosted_vllm/solar-open2-250b
# 생성 계열은 low 로 충분합니다. 추론 모델은 기본값에서 호출당 수천 토큰을 태웁니다.
WIKI_LLM_REASONING_EFFORT=low
# 색인 대상 크기 상한(바이트). 초과 파일은 토글이 비활성됩니다.
WIKI_MAX_INPUT_BYTES=2097152
# 위키를 끈 뒤 트리를 실제로 지우기까지의 유예(일). 0 이면 다음 정리 회차에 삭제합니다.
WIKI_PURGE_GRACE_DAYS=30

# ── 대화형 질의 ──────────────────────────────────────
CHAT_ENABLED=true
# 비우면 WIKI_LLM_MODEL 을 그대로 씁니다. 채팅만 다른 모델로 붙여 비교할 때 지정하세요.
CHAT_LLM_MODEL=
# **인덱싱의 low 와 다릅니다.** 툴을 고르는 일은 생성이 아니라 판정이고, Solar 는 판정에서
# low 면 오판합니다. 추론 모델이 아닌 곳으로 갈아탈 때는 비우세요(파라미터를 안 보냅니다).
CHAT_LLM_REASONING_EFFORT=medium
# 툴 왕복 상한. 검색만 반복하다 끝나지 않게 하는 하드 캡입니다.
CHAT_MAX_TOOL_ITERATIONS=6
# 모델에 넘길 최근 대화 턴 수(1턴 = 질문+답변).
CHAT_HISTORY_TURNS=8
